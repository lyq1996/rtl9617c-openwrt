From: Leo <62428370+LeoooChen@users.noreply.github.com>
Subject: [PATCH] net: ethernet: realtek: add RTL9617C network interface

Hook up the Realtek RTL9617C network interface, flow engine offload,
optical front end and PON MAC drivers.

Signed-off-by: Leo <62428370+LeoooChen@users.noreply.github.com>
---
--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -6,7 +6,7 @@
 config NET_VENDOR_REALTEK
 	bool "Realtek devices"
 	default y
-	depends on PCI || (PARPORT && X86)
+	depends on PCI || (PARPORT && X86) || ARCH_RTL9617C || COMPILE_TEST
 	help
 	  If you have a network (Ethernet) card belonging to this class, say Y.
 
@@ -140,4 +140,6 @@
 	  To compile this driver as a module, choose M here: the module
 	  will be called rtase. This is recommended.
 
+source "drivers/net/ethernet/realtek/rtl9617c/Kconfig"
+
 endif # NET_VENDOR_REALTEK
--- a/drivers/net/ethernet/realtek/Makefile
+++ b/drivers/net/ethernet/realtek/Makefile
@@ -10,3 +10,4 @@
 r8169-$(CONFIG_R8169_LEDS) += r8169_leds.o
 obj-$(CONFIG_R8169) += r8169.o
 obj-$(CONFIG_RTASE) += rtase/
+obj-y += rtl9617c/
