From: Leo <62428370+LeoooChen@users.noreply.github.com>
Subject: [PATCH] phy: add the RTL9617C SGMII lane driver

Programs the SerDes lane that carries the P6 2.5G port: lane power and the
per-speed rate/analog/PCS sequence.

Signed-off-by: Leo <62428370+LeoooChen@users.noreply.github.com>
---
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -1,4 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0-only
+
+config PHY_RTL9617C_SGMII
+	bool "Realtek RTL9617C SGMII lane"
+	depends on OF && ARCH_RTL9617C
+	select GENERIC_PHY
+	help
+	  SerDes lane control for the RTL9617C SGMII ports.
+
 #
 # PHY
 #
--- a/drivers/phy/Makefile
+++ b/drivers/phy/Makefile
@@ -9,3 +9,4 @@
 obj-$(CONFIG_GENERIC_PHY)		+= phy-core.o
+obj-$(CONFIG_PHY_RTL9617C_SGMII) += phy-rtl9617c-sgmii.o
 obj-$(CONFIG_GENERIC_PHY_MIPI_DPHY)	+= phy-core-mipi-dphy.o
 obj-$(CONFIG_PHY_CAN_TRANSCEIVER)	+= phy-can-transceiver.o
