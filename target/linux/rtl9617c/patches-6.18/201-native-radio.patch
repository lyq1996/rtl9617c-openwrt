From: Leo <62428370+LeoooChen@users.noreply.github.com>
Subject: [PATCH] wireless: add the RTL AX AP driver integration

Register the native RTL AX AP wireless driver Kconfig and build files,
with cfg80211 and mac80211 as in-tree dependencies.

Signed-off-by: Leo <62428370+LeoooChen@users.noreply.github.com>
---
--- a/drivers/net/wireless/realtek/Kconfig
+++ b/drivers/net/wireless/realtek/Kconfig
@@ -12,6 +12,8 @@
 
 if WLAN_VENDOR_REALTEK
 
+source "drivers/net/wireless/realtek/rtl_ax_ap/Kconfig"
+
 source "drivers/net/wireless/realtek/rtl818x/Kconfig"
 source "drivers/net/wireless/realtek/rtlwifi/Kconfig"
 source "drivers/net/wireless/realtek/rtl8xxxu/Kconfig"
--- a/drivers/net/wireless/realtek/Makefile
+++ b/drivers/net/wireless/realtek/Makefile
@@ -3,6 +3,7 @@
 # Makefile for the Linux Wireless network device drivers for Realtek units
 #
 
+obj-$(CONFIG_RTL_AX_AP)		+= rtl_ax_ap/
 obj-$(CONFIG_RTL8180)		+= rtl818x/
 obj-$(CONFIG_RTL8187)		+= rtl818x/
 obj-$(CONFIG_RTLWIFI)		+= rtlwifi/
