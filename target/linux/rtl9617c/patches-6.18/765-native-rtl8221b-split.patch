From: Leo <62428370+LeoooChen@users.noreply.github.com>
Subject: [PATCH] net: phy: realtek: build the RTL8221B board code as a source file

Move the board-specific RTL8221B bring-up out of a header that was
included into realtek_main.c and compile it on its own. The three
realtek_main.c helpers it calls become non-static, with prototypes in
realtek.h, and the board header now only carries prototypes.

Signed-off-by: Leo <62428370+LeoooChen@users.noreply.github.com>
---
--- a/drivers/net/phy/realtek/Makefile
+++ b/drivers/net/phy/realtek/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 realtek-y			+= realtek_main.o
+realtek-y			+= rtl8221b-rtl9617c.o
 realtek-y			+= phy_patch.o
 realtek-y			+= phy_patch_rtl826x.o
 realtek-$(CONFIG_REALTEK_PHY_HWMON) += realtek_hwmon.o
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -2182,7 +2182,7 @@
 	return 0;
 }
 
-static int rtl822x_c45_get_features(struct phy_device *phydev)
+int rtl822x_c45_get_features(struct phy_device *phydev)
 {
 	linkmode_set_bit(ETHTOOL_LINK_MODE_TP_BIT,
 			 phydev->supported);
@@ -2193,7 +2193,7 @@
 	return genphy_c45_pma_read_abilities(phydev);
 }
 
-static int rtl822x_c45_config_aneg(struct phy_device *phydev)
+int rtl822x_c45_config_aneg(struct phy_device *phydev)
 {
 	bool changed = false;
 	int ret, val;
@@ -3051,7 +3051,7 @@
 	return ret;
 }
 
-static int rtlgen_c45_resume(struct phy_device *phydev)
+int rtlgen_c45_resume(struct phy_device *phydev)
 {
 	int ret = genphy_c45_pma_resume(phydev);
 
@@ -3811,6 +3811,7 @@
 	return 0;
 }
 
+
 #include "rtl8221b-rtl9617c.h"
 
 static struct phy_driver realtek_drvs[] = {
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -19,4 +19,8 @@
 
 int rtl822x_hwmon_init(struct phy_device *phydev);
 
+int rtl822x_c45_get_features(struct phy_device *phydev);
+int rtl822x_c45_config_aneg(struct phy_device *phydev);
+int rtlgen_c45_resume(struct phy_device *phydev);
+
 #endif /* REALTEK_H */
