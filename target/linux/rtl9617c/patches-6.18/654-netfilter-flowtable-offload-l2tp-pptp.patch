+	path->ppp_tunnel.opts.sid = htons((u16)session->session_id);
+	path->ppp_tunnel.opts.peer_tid = htons((u16)tunnel->peer_tunnel_id);
+	path->ppp_tunnel.opts.peer_sid = htons((u16)session->peer_session_id);
