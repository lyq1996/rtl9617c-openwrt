+static int pptp_fill_forward_path(struct net_device_path_ctx *ctx,
+				  struct net_device_path *path,
+				  const struct ppp_channel *chan)
+{
+	struct sock *sk = (struct sock *)chan->private;
+	struct pppox_sock *po;
+	struct pptp_opt *opt;
+	struct net_device *dev;
+	struct neighbour *n;
+	struct rtable *rt;
+	struct flowi4 fl4;
+	u8 ha[ETH_ALEN];
+	__be32 gw;
+
+	if (!sk || !(sk->sk_state & PPPOX_CONNECTED) ||
+	    (sk->sk_state & PPPOX_DEAD) || sock_flag(sk, SOCK_DEAD))
+		return -ENODEV;
+
+	po = pppox_sk(sk);
+	opt = &po->proto.pptp;
+	if (!opt->src_addr.sin_addr.s_addr || !opt->dst_addr.sin_addr.s_addr)
+		return -EINVAL;
+
+	rt = pptp_route_output(po, &fl4);
+	if (IS_ERR(rt))
+		return PTR_ERR(rt);
+
+	dev = rt->dst.dev;
+	if (!dev || dev == ctx->dev || (dev->flags & IFF_LOOPBACK) ||
+	    dst_xfrm(&rt->dst)) {
+		ip_rt_put(rt);
+		return -EOPNOTSUPP;
+	}
+
+	memset(ha, 0, sizeof(ha));
+	if (dev->type == ARPHRD_PPP) {
+		if (!dev->netdev_ops || !dev->netdev_ops->ndo_fill_forward_path) {
+			ip_rt_put(rt);
+			return -EOPNOTSUPP;
+		}
+	} else {
+		if (dev->type != ARPHRD_ETHER || dev->addr_len != ETH_ALEN) {
+			ip_rt_put(rt);
+			return -EOPNOTSUPP;
+		}
+		if (rt->rt_gw_family == AF_INET6) {
+#if IS_ENABLED(CONFIG_IPV6)
+			n = __ipv6_neigh_lookup_noref_stub(dev, &rt->rt_gw6);
+#else
+			n = NULL;
+#endif
+		} else {
+			gw = rt->rt_gw_family == AF_INET ? rt->rt_gw4 : fl4.daddr;
+			n = __ipv4_neigh_lookup_noref(dev, (__force u32)gw);
+		}
+		if (!n || !(READ_ONCE(n->nud_state) & NUD_VALID)) {
+			ip_rt_put(rt);
+			return -ENOENT;
+		}
+		neigh_ha_snapshot(ha, n, dev);
+		if (!is_valid_ether_addr(ha)) {
+			ip_rt_put(rt);
+			return -ENOENT;
+		}
+		ether_addr_copy(ctx->daddr, ha);
+	}
+
+	path->type = DEV_PATH_PPP_TUNNEL;
+	path->dev = ctx->dev;
+	path->ppp_tunnel.opts.proto = IPPROTO_GRE;
+	path->ppp_tunnel.opts.ppp_len = 4 -
+		((opt->ppp_flags & SC_COMP_AC) ? 2 : 0) -
+		((opt->ppp_flags & SC_COMP_PROT) ? 1 : 0);
+	path->ppp_tunnel.opts.flags = NETDEV_PPP_TUN_F_SEQ;
+	path->ppp_tunnel.opts.tid = htons(opt->src_addr.call_id);
+	path->ppp_tunnel.opts.peer_tid = htons(opt->dst_addr.call_id);
+	path->ppp_tunnel.opts.gre_seq = htonl(READ_ONCE(opt->seq_sent) + 16);
+	path->ppp_tunnel.addr_family = AF_INET;
+	path->ppp_tunnel.ipv4.saddr = opt->src_addr.sin_addr.s_addr;
+	path->ppp_tunnel.ipv4.daddr = opt->dst_addr.sin_addr.s_addr;
+	ether_addr_copy(path->ppp_tunnel.h_dest, ha);
+
+	ctx->dev = dev;
+	ip_rt_put(rt);
+	return 0;
+}
