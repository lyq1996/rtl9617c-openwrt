#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Populate per-unit firmware before boot's kmodloader probes the radios.

# PT1500: skip the TYFZA1 factory import entirely; factory.uc hangs on the
# PT1500 vendor blob and blocks procd before the console starts.
MODEL=$(cat /proc/device-tree/model 2>/dev/null; cat /sys/firmware/devicetree/base/model 2>/dev/null)
case "$MODEL" in
	*PT1500*) exit 0 ;;
esac

START=09

start() {
	# PT1500 uses the fip/ubi_Config layout and does not ship the TYFZA1
	# factory blob; running factory.uc against it hangs the boot.
	# Use the always-present DT model/compatible, not /tmp/sysinfo.
	for f in /sys/firmware/devicetree/base/model /proc/device-tree/model; do
		[ -r "$f" ] && grep -aq "PT1500" "$f" && return 0
	done
	for f in /sys/firmware/devicetree/base/compatible /proc/device-tree/compatible; do
		[ -r "$f" ] && grep -aq "youhua,pt1500-h10" "$f" && return 0
	done
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "youhua,pt1500-h10" ] && return 0
	local source=/tmp/tyfza1-factory-source
	local runtime=/tmp/tyfza1-factory
	local device address mounted=0

	# Invalidate the previous import before attempting to access the factory volume.
	rm -rf "$runtime" /var/run/tyfza1-factory
	if [ ! -d /sys/class/ubi/ubi0 ]; then
		for device in /sys/class/mtd/mtd*/name; do
			[ "$(cat "$device")" = ubi_device ] || continue
			device=${device%/name}
			ubiattach /dev/ubi_ctrl -m "${device##*mtd}" || return $?
			break
		done
	fi
	. /lib/tyfza1-factory.sh
	if tyf_factory_published; then
		/usr/libexec/tyfza1-factory-source "$source" || return $?
	else
		mkdir -p "$source"
		mount -t ubifs -o ro ubi0:ubi_Config "$source" || return $?
		mounted=1
	fi
	mkdir -p /tmp/log
	/usr/share/tyfza1/factory.uc "$source" / > /tmp/log/tyfza1-factory.log 2>&1
	local result=$?
	while IFS= read -r line; do
		printf 'tyfza1-factory: %s\n' "$line" > /dev/kmsg
	done < /tmp/log/tyfza1-factory.log
	if [ "$mounted" = 1 ]; then umount "$source"; else rm -rf "$source"; fi
	# NI registers belong to the preceding boot, not to the factory identity.
	# Like stock, all LAN switch ports share ELAN; netifd applies user overrides later.
	if [ -f "$runtime/lan_mac" ]; then
		read -r address < "$runtime/lan_mac"
		for device in /sys/class/net/lan[1-5]; do
			[ -e "$device" ] || continue
			ip link set dev "${device##*/}" address "$address" || return $?
		done
	fi
	# Ethernet identity is independent of EPON registration and PON enablement.
	# Apply it before netifd creates WAN VLANs or starts DHCP/PPPoE.
	device=/sys/bus/platform/devices/4f5500000.pon
	if [ -d "$device" ]; then
		cat "$runtime/lan_mac" > "$device/data_mac" || return $?
	fi
	return "$result"
}
