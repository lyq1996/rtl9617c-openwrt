#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
youhua,pt1500-h10|youhua,pt1500-h10-2p5g)
	# No switch: every jack is its own NI MAC port with its own PHY, and
	# the NIC registers one netdev per port that has a PHY (lan1..lan4 for
	# NI port 0..3 on the RTL8211 GE PHYs, lan5 for NI port 4 on the
	# RTL8221B 2.5G PHY behind the SGMII lane).
	#
	# The chassis has four jacks: the first is 2.5G, the other three are
	# GE. The OEM names them eth0.2..eth0.5 and remaps them with
	# /proc/realtek/uni_capability "REMAP 4;1;2;3", i.e. silkscreen
	# LAN1 = NI port 4 (2.5G, lan5), LAN2..LAN4 = NI ports 1..3 (lan2..lan4).
	# NI port 0 is not wired to a jack, so it is listed last and dropped
	# when the driver did not register it.
	#
	# WAN is not configured here: the PON netdev (pon0) does not exist
	# yet, and uci-defaults/90-tyfza1-pon-wan binds wan to pon0 as soon
	# as the PON driver exposes it.
	lan_ports=
	for port in lan5 lan2 lan3 lan4 lan1; do
		[ -e "/sys/class/net/$port" ] && lan_ports="$lan_ports $port"
	done
	[ -n "$lan_ports" ] || lan_ports="lan1 lan2 lan3 lan4"
	ucidef_set_interface_lan "$lan_ports"
	;;
*)
	lan_ports="lan1 lan2 lan3 lan4"
	ucidef_set_interfaces_lan_wan "$lan_ports" "pon0"
	if [ -f /tmp/tyfza1-factory/lan_mac ]; then
		read -r address < /tmp/tyfza1-factory/lan_mac
		ucidef_set_interface_macaddr lan "$address"
		ucidef_set_label_macaddr "$address"
	fi
	;;
esac

board_config_flush
