// SPDX-License-Identifier: GPL-2.0-only
// Youhua PT1500-H10: 10G-EPON HGU on the RTL9617C (Cortina Taurus) reference
// design. Board facts (LED/button wiring, flash layout, reserved memory) are
// taken from this unit's own OEM DTB and live flash, not another Taurus board.
// No WiFi: the three PCIe controllers have no endpoints (PCIE2 clock gated);
// their nodes are omitted and only the shared pcie-controls block stays.
/dts-v1/;
#include "rtl9617c.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

/ {
	model = "Youhua PT1500-H10";
	compatible = "youhua,pt1500-h10", "realtek,rtl9617c";

	aliases {
		serial0 = &uart0;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon console=ttyS0,115200n8 loglevel=7 clk_ignore_unused maxcpus=4";
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	// Same reservations the OEM kernel carries; release only with live
	// firmware/BL31 evidence per reservation.
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		voip-vector@0 {
			reg = <0 0 0 0x1000>;
			no-map;
		};
		voip@2000000 {
			reg = <0 0x02000000 0 0x00300000>;
			no-map;
		};
		voip-ipc@2300000 {
			reg = <0 0x02300000 0 0x00100000>;
			no-map;
		};
		ddr-noncache@9000000 {
			reg = <0 0x09000000 0 0x01a50000>;
		};
		ddr-cache@bc48000 {
			reg = <0 0x0bc48000 0 0x10000>;
		};
		tz-smc@eeff000 {
			reg = <0 0x0eeff000 0 0x1000>;
			no-map;
		};
		tz@ffc0000 {
			reg = <0 0x0ffc0000 0 0x40000>;
		};
	};

	// Panel lamps exactly as the OEM rtk_gpio_led table wires them: all ten
	// sit on GPIO bank 0, mixed polarity (LED_EPHY0..3 and the PON/LOS/PPP
	// lamps are active low). Labels keep the OEM names because the target's
	// LED helpers (rc.button/lights_toggle, hotplug.d/iface) address them by
	// name.
	leds {
		compatible = "gpio-leds";

		internet {
			label = "LED_PPP_G";
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		los {
			label = "LED_LOS";
			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
		};
		pon {
			label = "LED_PON";
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		};
		led_power: power {
			label = "LED_PWR_G";
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		phone {
			label = "LED_FXS";
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		};
		usb0 {
			label = "LED_USB0";
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "usbport";
		};
		lan0 {
			label = "LED_EPHY0";
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		};
		lan1 {
			label = "LED_EPHY1";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		};
		lan2 {
			label = "LED_EPHY2";
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		};
		lan3 {
			label = "LED_EPHY3";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		};
	};

	// OEM rtk_gpio board-reset-gpio is bank0 pin8, which is also U-Boot's
	// reset pin; the lights button is bank3 pin13 (gpio 96 + 13), the same
	// wiring the TYFZA1 uses.
	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		led-toggle {
			label = "led-toggle";
			linux,code = <KEY_LIGHTS_TOGGLE>;
			gpios = <&gpio0 109 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&uart0 {
	status = "okay";
};

// The OEM watchdog uses the same 134-cycle reset delay as TYFZA1.
&watchdog {
	reset-on-timeout;
	delay-reset = <134>;
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x200000>;
				read-only;
			};
			partition@280000 {
				label = "env";
				reg = <0x280000 0x40000>;
			};
			partition@2c0000 {
				label = "env2";
				reg = <0x2c0000 0x40000>;
			};
			partition@300000 {
				label = "static_conf";
				reg = <0x300000 0x40000>;
			};
			partition@340000 {
				label = "ubi_device";
				reg = <0x340000 0xf5c0000>;
			};
		};
	};
};

// PHY 1..4 are the four internal Taurus GPHYs behind the NI register window,
// not external RTL8211s: U-Boot reads 0x001ccac4 from each of them through
// 0xf4600000 (reg_base 0xf4600, phy_addr<<7, reg<<2). The 802.3 Clause 45
// part sits at address 7 on the MDIO pins (OEM scfg PHY 4 = addr 7, IF 0x0a).
&mdio {
	status = "okay";

	phy1: ethernet-phy@1 {
		reg = <1>;
	};
	phy2: ethernet-phy@2 {
		reg = <2>;
	};
	phy3: ethernet-phy@3 {
		reg = <3>;
	};
	phy4: ethernet-phy@4 {
		reg = <4>;
	};

	/* 2.5G jack: RTL8221B behind the Taurus SGMII lane, Clause 45 with the
	 * vendor HiSGMII bring-up (drivers/net/phy/realtek/rtl8221b-tyfza1.h).
	 * MDIO address 6: the bus scan reads 0x001cc849 there, while address 7
	 * (the OEM scfg table entry) answers nothing. */
	phy_2p5g: ethernet-phy@6 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <6>;
		realtek,hsgmii;
	};
};

&i2c0 {
	status = "okay";
	bosa0: optical-front-end@51 {
		compatible = "realtek,rtl9617c-bosa";
		reg = <0x51>;
	};
};

&{/soc} {
	pcie_controls: pcie-controls@f4320098 {
		compatible = "realtek,rtl9617c-pcie-controls";
		reg = <0 0xf4320098 0 4>, <0 0xf43200a0 0 4>,
		      <0 0xf43200c4 0 0x14>, <0 0xf432036c 0 4>, <0 0xf432009c 0 4>,
		      <4 0xf433b000 0 0x1000>, <0 0xf4600000 0 0x1000>;
		reg-names = "core-reset", "phy-reset", "phy-control", "power", "usb-reset",
			    "sgmii-analog", "sgmii-serdes";
		realtek,global-config = <&global_config>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#phy-cells = <1>;
	};

	gpio0: gpio@4f43292c0 {
		compatible = "realtek,rtl9617c-gpio";
		reg = <4 0xf43292c0 0 0xb4>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pinctrl 0 0 160>;
	};

	ne_irq: interrupt-controller@f4320164 {
		compatible = "realtek,rtl9617c-per-ictl", "cortina,per-ictl";
		reg = <0 0xf4320164 0 0x10>;
		interrupt-controller;
		#interrupt-cells = <1>;
		#address-cells = <0>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
	};

	ni0: ethernet@4f4300000 {
		compatible = "realtek,rtl9617c-ni";
		reg = <4 0xf4300000 0 0x10000>, <0 0xf4500000 0 0x2000>,
		      <4 0xf7001000 0 0x1000>, <4 0xf432d000 0 0x1000>,
		      <4 0xf4320098 0 4>, <4 0xf432f000 0 0x1000>;
		reg-names = "ni", "xram", "dma-lso", "qm-axi-reorder", "block-reset",
			    "l3fe-axi-reorder";
		realtek,qm-rx;
		// Port 0 is the primary netdev of the NI; ports 1..3 ride the same
		// engine and port 4 is the SGMII lane that carries the 2.5G PHY.
		// NI port n (n < 4) carries external PHY n+1, which is the OEM's
		// MAC port n.
		realtek,port = <0>;
		phy-handle = <&phy1>;
		realtek,lan-phys = <&phy1 &phy2 &phy3 &phy4 &phy_2p5g>;
		phys = <&pcie_controls 5>;
		phy-names = "sgmii";
		interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
	};

	pon@4f5500000 {
		compatible = "realtek,rtl9617c-pon";
		realtek,network-engine = <&ni0>;
		realtek,optical-front-end = <&bosa0>;
		tx-disable-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		reg = <4 0xf5500000 0 0xc000>, <4 0xf4320094 0 4>,
		      <4 0xf4320074 0 4>, <4 0xf432022c 0 4>,
		      <4 0xf4320080 0 8>, <4 0xf4320090 0 4>, <4 0xf4320180 0 8>, <4 0xf432007c 0 4>,
		      <4 0xf4329440 0 0x10>;
		reg-names = "mac", "control", "epon-control", "serdes-init", "optical-control", "optical-status", "top-irq", "gpon-control", "dying-gasp";
		interrupts-extended = <&ne_irq 5>, <&per_ictl 24>;
		interrupt-names = "pon", "dying-gasp";
		realtek,burst-polarity = <0>;
		realtek,los-invert = <0>;
	};

	usbphy: usb-phy@f432b020 {
		compatible = "realtek,rtl9617c-usb-phy";
		reg = <0 0xf432b020 0 0x18>, <0 0xf432b000 0 0x20>,
		      <0 0xf432b04c 0 0x10>, <0 0xf4337000 0 0x1000>,
		      <0 0xf432c500 0 0x1c>;
		reg-names = "usb2", "usb3", "extension", "serdes", "atu";
		#phy-cells = <0>;
		phys = <&pcie_controls 4>;
		phy-names = "lane";
		resets = <&pcie_controls 4>, <&pcie_controls 5>;
		reset-names = "core", "port1";
		// USB2 port-0 VBUS: stock bank4, pin13 (differs from TYFZA1).
		vbus-gpios = <&gpio0 141 GPIO_ACTIVE_HIGH>;
		realtek,usb2-addresses = [e0 e2 e4 e7 f4 e7 f4 e0 e0 e0];
		realtek,usb2-values-a = [1f f9 68 71 db 44 bb 25 21 25];
		realtek,usb3-addresses-a = [01 04 05 08 09 0a 0b 0d 0e 20 21 22 23 27 2b 33];
		realtek,usb3-values-a = /bits/ 16 <0xaccc 0x7000 0x6313 0x30d1 0x424c 0xa610 0xb905 0xef2e 0x1000 0x705e 0xf8e8 0x0003 0x0b66 0x0241 0x0038 0x0001>;
		realtek,usb2-values-b = [1f f9 6b 71 db 43 bb 26 22 26];
		realtek,usb3-addresses-b = [01 04 05 08 09 0a 0b 0d 0e 20 21 22 23 27 2b 33 09 09 09];
		realtek,usb3-values-b = /bits/ 16 <0xaccc 0x7000 0x6313 0x30d1 0x424c 0xc610 0xa905 0xef2e 0x1000 0x705e 0xf8e8 0x0003 0x0b66 0x0241 0x0038 0x0001 0x424c 0x404c 0x424c>;
	};

	usb: usb@f0200000 {
		compatible = "generic-xhci";
		reg = <0 0xf0200000 0 0x80000>;
		interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
		phys = <&usbphy>;
		phy-names = "usb";
	};
};
